images/
.venv/

# catalog.json is derivable from images/ via tools/build_catalog.py
catalog/catalog.json

# generated bundles, rebuilt by tools/build_viewer.py and the exporters
viewer/assets/
out/

# test artifacts, rewritten by the suites
maps/__selftest.json
maps/editor_test.json
maps/sprite_test.json
maps/subtile_test.json

__pycache__/
*.pyc
.DS_Store
